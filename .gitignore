# =========================================================
# Criminal Network Analysis Project - .gitignore
# =========================================================

# -------------------------
# Python
# -------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.egg-info/
*.egg
.eggs/
.installed.cfg
MANIFEST

# -------------------------
# Virtual environments
# Ignore venvs anywhere in the project
# -------------------------
venv/
.venv/
env/
ENV/

# -------------------------
# Environment / Secrets
# -------------------------
.env
.env.*
!.env.example

# -------------------------
# Python build / packaging
# -------------------------
build/
dist/
develop-eggs/
downloads/
parts/
sdist/
wheels/

# -------------------------
# Logs
# -------------------------
*.log
output.log

# -------------------------
# Node.js
# -------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -------------------------
# Frontend build files
# -------------------------
frontend/build/
frontend/dist/

# -------------------------
# Jupyter
# -------------------------
.ipynb_checkpoints/

# -------------------------
# IDE / Editors
# -------------------------
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
*.code-workspace

# -------------------------
# OS files
# -------------------------
.DS_Store
Thumbs.db

# -------------------------
# Backup / temporary files
# -------------------------
*.bak
*.tmp
*.temp

# -------------------------
# Local databases / SQLite
# -------------------------
*.sqlite
*.sqlite3
*.db

# -------------------------
# ML / Hugging Face caches
# -------------------------
.huggingface/
huggingface/
.cache/
transformers_cache/

# -------------------------
# Generated archives
# -------------------------
*.zip

# -------------------------
# Test / coverage output
# -------------------------
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/